{
  "name": "fastmail-assist",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Browser extension for Fastmail (Chrome and Firefox): say in a line what an email should say and get a draft in your voice, written from the whole conversation into your open draft or saved to Drafts. Never sends.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jarofclay/fastmail-assist.git"
  },
  "keywords": [
    "fastmail",
    "jmap",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "claude",
    "email",
    "ai-assistant",
    "manifest-v3"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "scan": "node scripts/scan-secrets.mjs",
    "check": "npm run scan && npm run typecheck && npm run test && npm run build",
    "package": "npm run check && node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "e2e": "FA_E2E=1 node scripts/build.mjs && node tests/e2e/smoke.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "squire-rte": "^2.4.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
